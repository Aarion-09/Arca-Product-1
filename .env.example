# ARCA environment. On Hostinger these go in hPanel > Node.js > Environment
# variables, NOT in a file. Nothing here is read from disk in production.

# ---------------------------------------------------------------------------
# REQUIRED BEFORE LAUNCH — the legal documents name these people.
# Sign-up is blocked in production until OPERATOR_RESPONSIBLE and
# OPERATOR_ADDRESS are set to real values.
# ---------------------------------------------------------------------------
OPERATOR_ENTITY="ARCA Ltd"
OPERATOR_RESPONSIBLE="Full name of the adult legally responsible"
OPERATOR_ADDRESS="Street, Town, Postcode"
OPERATOR_COUNTRY="United Kingdom"
CONTACT_EMAIL="hello@yourdomain.com"
PRIVACY_EMAIL="privacy@yourdomain.com"
SAFETY_EMAIL="safety@yourdomain.com"
ICO_REGISTRATION=""

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
# PORT is injected by Hostinger — do not set it.
APP_ORIGIN="https://yourdomain.com"
ADMIN_EMAIL="you@yourdomain.com"

# ---------------------------------------------------------------------------
# Database (Hostinger > Databases > MySQL)
# Without DB_NAME the app runs on in-memory storage and loses data on restart.
# ---------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_POOL="8"

# ---------------------------------------------------------------------------
# Email. Without these, sign-up still works but confirmation links are written
# to the server log instead of being sent. Gmail requires an App Password.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ARCA <hello@yourdomain.com>"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ANALYTICS_DOMAIN=""
PAYMENTS_OPEN="false"
UPLOAD_DIR="public/uploads"
